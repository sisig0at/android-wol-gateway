# ============================================================================
#  Wake-on-LAN gateway configuration example.
#  Copy to .env and fill in your own values:
#      cp .env.example .env && chmod 600 .env
#  Never commit the real values (this file lists safe placeholder examples).
# ============================================================================

# --- Required ---------------------------------------------------------------

# Bot token from @BotFather (format like 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Your own Telegram user ID (integer; ask @userinfobot for it).
# Commands are accepted ONLY from this user.
TELEGRAM_USER_ID=

# MAC address of the PC's WIRED network card (Ethernet, not Wi-Fi).
# Windows: getmac /v  or  ipconfig /all  -> "Physical Address".
# Format: XX:XX:XX:XX:XX:XX or XX-XX-XX-XX-XX-XX
PC_MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# --- Recommended (only needed for the /status command) ----------------------

# Local IP of the PC on the home network (WoL itself does not need it,
# only /status does). Reserve a DHCP lease on your router so it stays stable.
PC_LOCAL_IP=192.168.1.10

# Ports /status uses to detect that the PC is already up.
# 3389 = RDP (if enabled on Windows), 445 = SMB.
PC_STATUS_PORTS=3389,445

# --- Optional (defaults match the code) -------------------------------------

# Where the Magic Packet is sent: 255.255.255.255 or a subnet broadcast
# such as 192.168.1.255 (use the subnet broadcast if global broadcast
# does not pass your router).
WOL_BROADCAST_ADDR=255.255.255.255

# UDP port for the Magic Packet (7 or 9; 9 is the convention).
WOL_PORT=9

# Anti-double-tap guard: minimum seconds between two /pc commands.
WAKE_COOLDOWN_SECONDS=20

# Seconds after /pc during which /status reports a machine as "waking up"
# instead of "offline" (covers the Windows boot window).
WAKING_TIMEOUT_SECONDS=180

# Ping timeout in seconds (only used if a ping binary is available).
PING_TIMEOUT_SECONDS=2

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
